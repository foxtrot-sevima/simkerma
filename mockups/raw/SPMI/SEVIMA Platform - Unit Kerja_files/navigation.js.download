teY(0);\n                        opacity: 1;\n                    }\n                }\n\n                .rating-widget__header {\n                    display: flex;\n                    justify-content: space-between;\n                    align-items: flex-start;\n                    margin-bottom: 16px;\n                    padding-bottom: 12px;\n                    border-bottom: 1px solid #e5e7eb;\n                }\n\n                .rating-widget__title {\n                    font-size: 18px;\n                    font-weight: 700;\n                    color: #111827;\n                    margin: 0;\n                    flex: 1;\n                }\n\n                .rating-widget__close {\n                    background: none;\n                    border: none;\n                    cursor: pointer;\n                    padding: 4px;\n                    color: #9ca3af;\n                    font-size: 22px;\n                    line-height: 1;\n                    flex-shrink: 0;\n                }\n\n                .rating-widget__close:hover {\n                    color: #374151;\n                }\n\n                .rating-widget__description {\n                    font-size: 14px;\n                    color: #6C737F;\n                    margin-bottom: 24px;\n                    line-height: 1.5;\n                }\n\n                .rating-section {\n                    margin-bottom: 20px;\n                }\n\n                .rating-section__label {\n                    font-size: 14px;\n                    font-weight: 500;\n                    color: #384250;\n                    margin-bottom: 8px;\n                    display: block;\n                }\n\n                .rating-section__stars {\n                    display: flex;\n                    gap: 4px;\n                }\n\n                .star {\n                    width: 32px;\n                    height: 32px;\n                    cursor: pointer;\n                    transition: transform 0.2s;\n                }\n\n                .star:hover {\n                    transform: scale(1.1);\n                }\n\n                .star svg {\n                    width: 100%;\n                    height: 100%;\n                }\n\n                .rating-widget__feedback {\n                    margin-bottom: 20px;\n                }\n                .rating-widget__feedback-label {\n                    font-size: 14px;\n                    font-weight: 500;\n                    color: #384250;\n                    margin-bottom: 8px;\n                    display: block;\n                }\n                .rating-widget__feedback-label-optional {\n                    font-weight: 400;\n                    color: #6C737F;\n                }\n                .rating-widget__feedback-textarea {\n                    width: 100%;\n                    min-height: 80px;\n                    padding: 10px 12px;\n                    border: 1px solid #E5E7EB;\n                    border-radius: 8px;\n                    font-size: 14px;\n                    font-family: 'Poppins', sans-serif;\n                    color: #1F2937;\n                    resize: vertical;\n                    box-sizing: border-box;\n                }\n                .rating-widget__feedback-textarea::placeholder {\n                    color: #9CA3AF;\n                }\n                .rating-widget__feedback-textarea:focus {\n                    outline: none;\n                    border-color: #0F6AF5;\n                    box-shadow: 0 0 0 2px rgba(15, 106, 245, 0.15);\n                }\n\n                .rating-widget__feedback-hint {\n                    font-size: 11px;\n                    color: #9ca3af;\n                    text-align: right;\n                    margin-top: 4px;\n                }\n                .rating-widget__feedback-hint--error {\n                    color: #b91c1c;\n                    font-weight: 500;\n                }\n                .rating-widget__actions {\n                    display: flex;\n                    gap: 12px;\n                    margin-top: 16px;\n                }\n\n                .rating-widget__button {\n                    flex: 1;\n                    padding: 10px 16px;\n                    border-radius: 8px;\n                    font-size: 14px;\n                    font-weight: 500;\n                    cursor: pointer;\n                    transition: all 0.2s;\n                    font-family: 'Poppins', sans-serif;\n                }\n\n                .rating-widget__button--primary {\n                    background: #3b82f6;\n                    color: white;\n                    border: none;\n                }\n\n                .rating-widget__button--primary:hover:not(:disabled) {\n                    background: #2563eb;\n                }\n\n                .rating-widget__button--secondary {\n                    background: white;\n                    color: #374151;\n                    border: 1px solid #d1d5db;\n                }\n\n                .rating-widget__button--secondary:hover {\n                    background: #f9fafb;\n                }\n\n                .rating-widget__button:disabled {\n                    opacity: 0.5;\n                    cursor: not-allowed;\n                }\n\n                .rating-widget__message {\n                    display: none;\n                    padding: 10px 14px;\n                    border-radius: 8px;\n                    font-size: 13px;\n                    line-height: 1.4;\n                    margin-bottom: 16px;\n                }\n                .rating-widget__message.rating-widget__message--show {\n                    display: block;\n                    animation: ratingMessageIn 0.25s ease-out;\n                }\n                @keyframes ratingMessageIn {\n                    from { opacity: 0; transform: translateY(-4px); }\n                    to { opacity: 1; transform: transla